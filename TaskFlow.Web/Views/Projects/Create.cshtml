@model TaskFlow.Web.ViewModels.Projects.ProjectCreateInputModel

@{
    ViewData["Title"] = "Create project";
    int teamId = (int)ViewData["TeamId"]!;
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-7">
        <h1>Create a project</h1>
        <p class="text-muted">The project will belong to this team and be available to its members.</p>

        <form asp-action="Create" asp-route-teamId="@teamId" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autocomplete="off" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Deadline" class="form-label"></label>
                <input asp-for="Deadline" class="form-control" />
                <span asp-validation-for="Deadline" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create project</button>
            <a asp-controller="Projects" asp-action="Index" asp-route-teamId="@teamId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
